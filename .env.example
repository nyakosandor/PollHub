# Copy this file to .env and adjust the values.

# SQLite database file, relative to the project root.
DATABASE_URL="file:./dev.db"

# NextAuth: secret used to sign session tokens (generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ) and the app's base URL.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Lists the seeded demo accounts on the login page (local evaluation only).
SHOW_DEMO_ACCOUNTS="true"
